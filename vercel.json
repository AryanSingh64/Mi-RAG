{
  "version": 2,
  "routes": [
    {
      "src": "/install",
      "dest": "/install.ps1",
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/web/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web/templates/index.html"
    }
  ]
}
