{
  "framework": null,
  "installCommand": "echo 'Skip install'",
  "buildCommand": "echo 'Build static'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.ps1"
    }
  ],
  "headers": [
    {
      "source": "/install.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
